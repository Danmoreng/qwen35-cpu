# Browser bindings share the native model, tokenizer and System One protocol.
FetchContent_Declare(wasm_json
  URL https://codeload.github.com/nlohmann/json/tar.gz/refs/tags/v3.12.0
  URL_HASH SHA256=4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187
  SOURCE_SUBDIR unused)
FetchContent_MakeAvailable(wasm_json)
add_library(qev_browser_api STATIC src/wasm/decision.cpp)
target_include_directories(qev_browser_api PRIVATE src ${wasm_json_SOURCE_DIR}/single_include)
target_link_libraries(qev_browser_api PUBLIC qwen35x_core)
if (EMSCRIPTEN)
  file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/wasm-licenses)
  configure_file(${CMAKE_SOURCE_DIR}/LICENSE ${CMAKE_BINARY_DIR}/wasm-licenses/qwen35-cpu.txt COPYONLY)
  configure_file(${CMAKE_SOURCE_DIR}/licenses/decider-ai.txt ${CMAKE_BINARY_DIR}/wasm-licenses/decider-ai.txt COPYONLY)
  configure_file(${CMAKE_SOURCE_DIR}/licenses/ggml.txt ${CMAKE_BINARY_DIR}/wasm-licenses/ggml.txt COPYONLY)
  configure_file(${utf8proc_SOURCE_DIR}/LICENSE.md ${CMAKE_BINARY_DIR}/wasm-licenses/utf8proc.txt COPYONLY)
  configure_file(${wasm_json_SOURCE_DIR}/LICENSE.MIT ${CMAKE_BINARY_DIR}/wasm-licenses/nlohmann-json.txt COPYONLY)
  configure_file(${EMSCRIPTEN_ROOT_PATH}/LICENSE ${CMAKE_BINARY_DIR}/wasm-licenses/emscripten.txt COPYONLY)
  if ((QWEN35_WASM_RELAXED_DOT OR QWEN35_WASM_RELAXED_FMA) AND NOT QWEN35_WASM_SIMD)
    message(FATAL_ERROR "Relaxed instructions require WASM SIMD")
  endif ()
  if (QWEN35_WASM_SIMD)
    target_sources(qwen35x_core PRIVATE src/cpu/q4_dot4_wasm.cpp src/cpu/delta_net_wasm.cpp src/cpu/q4_h128_wasm.cpp)
    target_compile_definitions(qwen35x_core PRIVATE QWEN35X_HAS_WASM_SIMD_TU=1)
    if (QWEN35_WASM_RELAXED_DOT)
      # Only this translation unit emits relaxed instructions. Its unsigned
      # 0..15 weights guarantee exact integer semantics on every platform.
      set_source_files_properties(src/cpu/q4_dot4_wasm.cpp PROPERTIES COMPILE_OPTIONS -mrelaxed-simd)
      target_compile_definitions(qwen35x_core PRIVATE QWEN35X_HAS_WASM_RELAXED_DOT=1)
    endif ()
    if (QWEN35_WASM_RELAXED_FMA)
      # The browser selects this bundle only after a fused-arithmetic probe.
      set_source_files_properties(src/cpu/q4_dot4_wasm.cpp src/cpu/delta_net_wasm.cpp
        PROPERTIES COMPILE_OPTIONS -mrelaxed-simd)
      target_compile_definitions(qwen35x_core PRIVATE QWEN35X_HAS_WASM_RELAXED_FMA=1)
    endif ()
  endif ()
  add_executable(qev_wasm src/wasm/entry.cpp)
  target_link_libraries(qev_wasm PRIVATE qev_browser_api)
  set_target_properties(qev_wasm PROPERTIES SUFFIX ".js")
  foreach (target qwen35x_core qwen35_utf8proc qev_browser_api qev_wasm)
    target_compile_options(${target} PRIVATE -fexceptions)
    if (QWEN35_WASM_SIMD)
      target_compile_options(${target} PRIVATE -msimd128)
    else ()
      target_compile_options(${target} PRIVATE -fno-vectorize -fno-slp-vectorize)
    endif ()
    if (QWEN35_WASM_THREADS)
      target_compile_options(${target} PRIVATE -pthread)
    endif ()
  endforeach ()
  target_link_options(qev_wasm PRIVATE
    -fexceptions -sMODULARIZE=1 -sEXPORT_NAME=createQevModule
    -sENVIRONMENT=web,worker -sALLOW_MEMORY_GROWTH=1
    -sINITIAL_MEMORY=67108864 -sMAXIMUM_MEMORY=2147483648
    -sSTACK_SIZE=2097152 -sFORCE_FILESYSTEM=1 -lworkerfs.js
    "-sINCOMING_MODULE_JS_API=['locateFile','printErr','mainScriptUrlOrBlob']"
    "-sEXPORTED_FUNCTIONS=['_qev_tune','_qev_options','_qev_load','_qev_begin','_qev_step','_qev_cancel','_qev_debug','_qev_unload']"
    "-sEXPORTED_RUNTIME_METHODS=['ccall','FS','WORKERFS']")
  if (QWEN35_WASM_THREADS)
    target_link_options(qev_wasm PRIVATE -pthread -sPTHREAD_POOL_SIZE=7 -sPTHREAD_POOL_SIZE_STRICT=2)
  endif ()
  if (QWEN35_WASM_SIMD)
    target_link_options(qev_wasm PRIVATE -msimd128)
  endif ()
  if (QWEN35_WASM_RELAXED_DOT OR QWEN35_WASM_RELAXED_FMA)
    target_link_options(qev_wasm PRIVATE -mrelaxed-simd)
  endif ()
  add_executable(wasm_kernel_test tests/wasm_kernel_test.cpp)
  add_executable(wasm_delta_test tests/delta_net_test.cpp)
  target_link_libraries(wasm_delta_test PRIVATE qwen35x_core)
  target_link_options(wasm_delta_test PRIVATE -fexceptions -sENVIRONMENT=node -sEXIT_RUNTIME=1)
  target_link_libraries(wasm_kernel_test PRIVATE qwen35x_core)
  target_link_options(wasm_kernel_test PRIVATE -fexceptions -sENVIRONMENT=node -sEXIT_RUNTIME=1)
  if (QWEN35_WASM_RELAXED_DOT OR QWEN35_WASM_RELAXED_FMA)
    target_link_options(wasm_kernel_test PRIVATE -mrelaxed-simd)
    target_link_options(wasm_delta_test PRIVATE -mrelaxed-simd)
  endif ()
  if (QWEN35_WASM_SIMD)
    target_compile_options(wasm_kernel_test PRIVATE -msimd128)
    target_link_options(wasm_kernel_test PRIVATE -msimd128)
  endif ()
  if (QWEN35_WASM_RELAXED_FMA)
    target_compile_definitions(wasm_kernel_test PRIVATE QWEN35X_HAS_WASM_RELAXED_FMA=1)
    target_compile_options(wasm_kernel_test PRIVATE -mrelaxed-simd)
  endif ()
  if (QWEN35_WASM_THREADS)
    target_compile_options(wasm_delta_test PRIVATE -pthread)
    target_link_options(wasm_delta_test PRIVATE -pthread -sPTHREAD_POOL_SIZE=7)
    target_compile_options(wasm_kernel_test PRIVATE -pthread)
    target_link_options(wasm_kernel_test PRIVATE -pthread -sPTHREAD_POOL_SIZE=7)
  endif ()
else ()
  add_executable(qev_browser_reference tools/qev-browser-reference.cpp)
  target_include_directories(qev_browser_reference PRIVATE ${wasm_json_SOURCE_DIR}/single_include)
  target_link_libraries(qev_browser_reference PRIVATE qev_browser_api)
endif ()
