+#if DOT4_AVX2
+template <std::size_t Offset, std::size_t... T>
+DOT4_INLINE void paired_tile(const Q4_0BlockX8 *matrix, const Q8_0BlockX4 *vectors,
+    float *output, std::size_t blocks, std::size_t stride, std::index_sequence<T...>) noexcept {
+  __m256 sum0[sizeof...(T)] = {((void)T, _mm256_setzero_ps())...};
+  __m256 sum1[sizeof...(T)] = {((void)T, _mm256_setzero_ps())...};
+  const auto mask = _mm256_set1_epi8(15);
+  for (std::size_t b = 0; b < blocks; ++b) {
+    const auto &a = vectors[b];
+    __m256i p0[sizeof...(T)] = {((void)T, _mm256_setzero_si256())...};
+    __m256i p1[sizeof...(T)] = {((void)T, _mm256_setzero_si256())...};
+    for (std::size_t c = 0; c < 4; ++c) {
+      const auto raw0 = _mm256_loadu_si256(reinterpret_cast<const __m256i *>(matrix[b].qs + c*32));
+      const auto raw1 = _mm256_loadu_si256(reinterpret_cast<const __m256i *>(matrix[b+blocks].qs + c*32));
+      const auto lo0 = _mm256_and_si256(raw0, mask);
+      const auto lo1 = _mm256_and_si256(raw1, mask);
+      const auto hi0 = _mm256_and_si256(_mm256_srli_epi16(raw0,4), mask);
+      const auto hi1 = _mm256_and_si256(_mm256_srli_epi16(raw1,4), mask);
+      const auto pair = [&]<std::size_t I>() {
+        const auto *q = a.qs + (I+Offset)*32 + c*8;
+        const auto x = broadcast4(q);
+        const auto y = broadcast4(q+4);
+        p0[I] = _mm256_add_epi16(p0[I], _mm256_add_epi16(_mm256_maddubs_epi16(lo0,x),_mm256_maddubs_epi16(hi0,y)));
+        p1[I] = _mm256_add_epi16(p1[I], _mm256_add_epi16(_mm256_maddubs_epi16(lo1,x),_mm256_maddubs_epi16(hi1,y)));
+#if defined(__GNUC__) || defined(__clang__)
+        __asm__("" : "+x"(p0[I]), "+x"(p1[I]));
+#endif
+      };
+      (pair.template operator()<T>(), ...);
+    }
+    const auto w0 = _mm256_cvtph_ps(_mm_loadu_si128(reinterpret_cast<const __m128i *>(matrix[b].d)));
+    const auto w1 = _mm256_cvtph_ps(_mm_loadu_si128(reinterpret_cast<const __m128i *>(matrix[b+blocks].d)));
+    const auto finish = [&]<std::size_t I>() {
+      const auto corr = _mm256_set1_epi32(8 * static_cast<int>(a.sums[I+Offset]));
+      const auto scale = _mm256_set1_ps(a.scales[I+Offset]);
+      const auto dot0 = _mm256_sub_epi32(_mm256_madd_epi16(p0[I],_mm256_set1_epi16(1)),corr);
+      const auto dot1 = _mm256_sub_epi32(_mm256_madd_epi16(p1[I],_mm256_set1_epi16(1)),corr);
+      sum0[I] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(dot0),_mm256_mul_ps(w0,scale),sum0[I]);
+      sum1[I] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(dot1),_mm256_mul_ps(w1,scale),sum1[I]);
+    };
+    (finish.template operator()<T>(), ...);
+  }
+  (_mm256_storeu_ps(output + (T+Offset)*stride,sum0[T]), ...);
+  (_mm256_storeu_ps(output + (T+Offset)*stride+8,sum1[T]), ...);
+}
+#endif
