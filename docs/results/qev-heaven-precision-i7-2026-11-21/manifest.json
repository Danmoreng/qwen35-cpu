  "harness_patch": "--- benchmark-systemone-http.py\n+++ benchmark-quality-http.py\n@@ -10,6 +10,7 @@\n import json\n import os\n import math\n+import re\n from pathlib import Path\n import socket\n import subprocess\n@@ -37,6 +38,9 @@\n     p.add_argument('--concurrency', type=int, default=1)\n     p.add_argument('--requests', type=int, help='Total requests in the sample; defaults to concurrency')\n     p.add_argument('--distinct-states', action='store_true')\n+    p.add_argument('--disable-gguf-checkpoints', action='store_true')\n+    p.add_argument('--clear-gguf-slot', action='store_true')\n+    p.add_argument('--inspect-upstream-cache', action='store_true')\n     p.add_argument('--profile-json', type=Path, required=True)\n     args = p.parse_args()\n     if not 1 <= args.concurrency <= 16:raise ValueError('concurrency must be 1..16')\n@@ -63,6 +67,14 @@\n               '--no-warmup','--cache-ram','0','--host','127.0.0.1','--port',str(port)]\n         if args.batch_size:cmd+=['--batch-size',str(args.batch_size)]\n         if args.ubatch_size:cmd+=['--ubatch-size',str(args.ubatch_size)]\n+    if args.backend == 'native':\n+        cmd += ['--prefix-cache', 'off']\n+    if args.disable_gguf_checkpoints:\n+        cmd += ['--ctx-checkpoints', '0']\n+    if args.clear_gguf_slot:\n+        cmd += ['--slot-save-path', str(args.profile_json.parent.resolve())]\n+    if args.inspect_upstream_cache:\n+        cmd += ['--metrics']\n     body=args.request.read_bytes()\n     # Concurrency matrices use a different state per request, including B1,\n     # so identical prefixes/results cannot turn the test into a cache benchmark.\n@@ -99,7 +111,26 @@\n                 with urllib.request.urlopen(req,timeout=120) as response:raw=response.read()\n                 return (time.perf_counter()-start)*1000,json.loads(raw)\n             start=time.perf_counter()\n-            if args.concurrency == 1:results=[decide(payload) for payload in bodies]\n+            if args.concurrency == 1:\n+                results = []\n+                with args.profile_json.with_suffix('.responses.jsonl').open('w', buffering=1) as partial:\n+                    for index, payload in enumerate(bodies):\n+                        if index and args.clear_gguf_slot:\n+                            clear = urllib.request.Request(base+'/slots/0?action=erase', data=b'{}', method='POST')\n+                            with urllib.request.urlopen(clear, timeout=10) as reply:\n+                                erased = json.load(reply)\n+                            assert erased.get('id_slot') == 0 and erased.get('n_erased', 0) >= 0\n+                        stamp = time.perf_counter()\n+                        try:\n+                            result = decide(payload)\n+                        except urllib.error.HTTPError as error:\n+                            result = ((time.perf_counter()-stamp)*1000,\n+                                      {'error': {'status': error.code, 'detail': error.read().decode(errors='replace')},\n+                                       'usage': {'input_tokens': 0, 'output_tokens': 0}})\n+                        results.append(result)\n+                        partial.write(json.dumps({'id': ids[index], 'latency_ms': result[0], 'response': result[1]})+'\\n')\n+                        if (index + 1) % 25 == 0:\n+                            print(f'Completed {index + 1}/{len(bodies)} requests', flush=True)\n             else:\n                 with concurrent.futures.ThreadPoolExecutor(max_workers=args.concurrency) as pool:\n                     results=list(pool.map(decide,bodies))\n@@ -115,6 +146,13 @@\n                     fields = dict(line.split(':', 1) for line in status.read_text().splitlines())\n                     panel_info['server_peak_rss_bytes'] = int(fields['VmHWM'].split()[0]) * 1024\n                     panel_info['server_allowed_cpus'] = fields['Cpus_allowed_list'].strip()\n+            if args.inspect_upstream_cache:\n+                with urllib.request.urlopen(base+'/metrics', timeout=5) as response:\n+                    metrics = response.read().decode()\n+                match = re.search(r'^llamacpp:prompt_tokens_cached_total\\s+(\\d+(?:\\.\\d+)?)$', metrics, re.MULTILINE)\n+                if match is None:\n+                    raise RuntimeError('Cached prompt token counter absent: '+metrics)\n+                panel_info['cached_prompt_tokens_total'] = int(float(match.group(1)))\n             if args.prefill_requests:\n                 with urllib.request.urlopen(base+'/v1/cache', timeout=5) as response:\n                     stats = json.load(response)\n",
