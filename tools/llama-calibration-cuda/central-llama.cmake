# Link project-specific adapters to the shared Windows llama.cpp build.
if(DEFINED ENV{LLAMA_CPP_HOME} AND NOT "$ENV{LLAMA_CPP_HOME}" STREQUAL "")
  set(_llama_default "$ENV{LLAMA_CPP_HOME}")
else()
  set(_llama_default "C:/llama.cpp")
endif()
set(CENTRAL_LLAMA_HOME "${_llama_default}" CACHE PATH "Shared llama.cpp checkout")
file(TO_CMAKE_PATH "${CENTRAL_LLAMA_HOME}" CENTRAL_LLAMA_HOME)
set(_llama_build "${CENTRAL_LLAMA_HOME}/build")
foreach(_file "include/llama.h" "ggml/include/ggml.h" "build/src/llama.lib" "build/ggml/src/ggml.lib" "build/ggml/src/ggml-base.lib")
  if(NOT EXISTS "${CENTRAL_LLAMA_HOME}/${_file}")
    message(FATAL_ERROR "Shared llama.cpp build is incomplete: ${CENTRAL_LLAMA_HOME}/${_file}")
  endif()
endforeach()
add_library(llama SHARED IMPORTED)
set_target_properties(llama PROPERTIES IMPORTED_IMPLIB "${_llama_build}/src/llama.lib" IMPORTED_LOCATION "${_llama_build}/bin/llama.dll" INTERFACE_INCLUDE_DIRECTORIES "${CENTRAL_LLAMA_HOME}/include;${CENTRAL_LLAMA_HOME}/ggml/include")
add_library(ggml SHARED IMPORTED)
set_target_properties(ggml PROPERTIES IMPORTED_IMPLIB "${_llama_build}/ggml/src/ggml.lib" IMPORTED_LOCATION "${_llama_build}/bin/ggml.dll" INTERFACE_INCLUDE_DIRECTORIES "${CENTRAL_LLAMA_HOME}/ggml/include")
add_library(ggml-base SHARED IMPORTED)
set_target_properties(ggml-base PROPERTIES IMPORTED_IMPLIB "${_llama_build}/ggml/src/ggml-base.lib" IMPORTED_LOCATION "${_llama_build}/bin/ggml-base.dll")
function(link_central_llama target)
  target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/central-llama-loader.cpp")
  target_compile_definitions(${target} PRIVATE "CENTRAL_LLAMA_BIN=\"${_llama_build}/bin\"")
  target_link_libraries(${target} PRIVATE llama ggml ggml-base delayimp)
  target_link_options(${target} PRIVATE /DELAYLOAD:llama.dll /DELAYLOAD:ggml.dll /DELAYLOAD:ggml-base.dll)
endfunction()
